# Hasura DDN v3 Engine Dockerfile
# This Dockerfile builds the Hasura DDN v3 engine with compiled metadata

# Use the official Hasura v3 engine image as base
# Note: As of now, Hasura provides pre-built v3 engine images
FROM ghcr.io/hasura/v3-engine:latest

# Set working directory
WORKDIR /md

# Copy compiled metadata from build directory
# These files are generated by: ddn supergraph build local
COPY build/auth_config.json /md/auth_config.json
COPY build/metadata.json /md/metadata.json
COPY build/open_dd.json /md/open_dd.json

# Environment variables for engine configuration
ENV AUTHN_CONFIG_PATH="/md/auth_config.json"
ENV METADATA_PATH="/md/open_dd.json"
ENV INTROSPECTION_METADATA_FILE="/md/metadata.json"
ENV ENABLE_CORS="true"

# Expose engine port
EXPOSE 3000

# The base image already has the entrypoint configured
# Engine will read metadata from the mounted /md directory
