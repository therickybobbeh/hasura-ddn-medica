# Development Environment Configuration Template
# Copy this file: cp .env.dev.template .env.dev
# Then update with your actual development environment values
# DO NOT commit .env.dev with real credentials to Git!

# ============================================
# HASURA DDN
# ============================================
# TODO: Get your Personal Access Token from https://console.hasura.io/settings/tokens
HASURA_DDN_PAT=ddn_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# POSTGRESQL DATABASE
# ============================================
# TODO: Update with your development database connection string
# Primary database
DATABASE_URL=postgresql://user:password@dev-db.example.com:5432/mydb_dev
CONNECTION_URI=${DATABASE_URL}

# TODO: (Optional) Configure read replicas if available
# Read replicas (optional)
# READ_REPLICA_1_URL=postgresql://user:password@dev-db-replica1.example.com:5432/mydb_dev
# READ_REPLICA_2_URL=postgresql://user:password@dev-db-replica2.example.com:5432/mydb_dev

# ============================================
# OAUTH / OIDC AUTHENTICATION
# ============================================
# TODO: Update with your development identity provider details
OAUTH_ISSUER_URL=https://dev-auth.example.com
OAUTH_JWKS_URL=https://dev-auth.example.com/.well-known/jwks.json
OAUTH_AUDIENCE=hasura-api-dev
OAUTH_CLIENT_ID=your-dev-client-id

# ============================================
# OPENTELEMETRY (Optional)
# ============================================
# TODO: Update if using observability in development
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4317
OTEL_SERVICE_NAME=hasura-ddn-dev

# ============================================
# POSTGRESQL CONNECTION POOL
# ============================================
# TODO: Adjust for development workload (typically lower than production)
POSTGRES_POOL_MAX_CONNECTIONS=20
POSTGRES_POOL_TIMEOUT=10
POSTGRES_POOL_IDLE_TIMEOUT=60

# ============================================
# DOCKER REGISTRY
# ============================================
# TODO: Update with your Docker registry
DOCKER_REGISTRY=docker.io/your-username

# ============================================
# KUBERNETES
# ============================================
K8S_NAMESPACE=hasura-dev

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
ENVIRONMENT=dev
LOG_LEVEL=debug
GRAPHQL_INTROSPECTION_ENABLED=true
GRAPHQL_PLAYGROUND_ENABLED=true
CORS_ALLOWED_ORIGINS=*
