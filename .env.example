# Hasura DDN Environment Variables Example
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to Git!

# ===========================
# Database Connection
# ===========================
# Your PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Examples:
# - Local: postgresql://postgres:password@localhost:5432/mydb
# - Neon: postgresql://user:pass@ep-cool-name-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
# - RDS: postgresql://user:pass@mydb.abcdefghijk.us-east-1.rds.amazonaws.com:5432/mydb

# ===========================
# Docker Registry
# ===========================
# Where to push your Docker images
# Examples:
# - Docker Hub: docker.io/yourusername
# - AWS ECR: 123456789.dkr.ecr.us-east-1.amazonaws.com
# - GCR: gcr.io/your-project
# - ACR: yourregistry.azurecr.io
DOCKER_REGISTRY=docker.io/yourusername

# ===========================
# Kubernetes
# ===========================
# Kubernetes namespace for deployment
K8S_NAMESPACE=hasura

# ===========================
# Authentication (Optional)
# ===========================
# Uncomment and configure to enable OAuth/OIDC authentication
# By default, authentication is DISABLED for quick testing
# See docs/AUTHENTICATION.md for setup instructions

# OAuth Issuer URL (your identity provider)
# OAUTH_ISSUER_URL=https://your-idp.example.com

# OAuth Audience (your API identifier)
# OAUTH_AUDIENCE=https://hasura.example.com

# JWKS URL for token verification
# OAUTH_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json

# ===========================
# Observability (Optional)
# ===========================
# OpenTelemetry endpoint for tracing/metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Service name for telemetry
# OTEL_SERVICE_NAME=hasura-ddn

# ===========================
# Advanced: Connection Pooling
# ===========================
# PostgreSQL connection pool settings
# POSTGRES_POOL_MAX_CONNECTIONS=50
# POSTGRES_POOL_TIMEOUT=30
# POSTGRES_POOL_IDLE_TIMEOUT=180
