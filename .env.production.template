# Production Environment Configuration Template
# Copy this file: cp .env.production.template .env.production
# Then update with your actual production environment values
# DO NOT commit .env.production with real credentials to Git!

# ============================================
# HASURA DDN
# ============================================
# TODO: Get your Personal Access Token from https://console.hasura.io/settings/tokens
HASURA_DDN_PAT=ddn_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# POSTGRESQL DATABASE
# ============================================
# TODO: Update with your production database connection string
# Primary database
DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/mydb_prod
CONNECTION_URI=${DATABASE_URL}

# TODO: (Optional) Configure read replicas (recommended for production)
# Read replicas (optional but recommended)
# READ_REPLICA_1_URL=postgresql://user:password@prod-db-replica1.example.com:5432/mydb_prod
# READ_REPLICA_2_URL=postgresql://user:password@prod-db-replica2.example.com:5432/mydb_prod

# ============================================
# OAUTH / OIDC AUTHENTICATION
# ============================================
# TODO: Update with your production identity provider details
OAUTH_ISSUER_URL=https://auth.example.com
OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
OAUTH_AUDIENCE=hasura-api-prod
OAUTH_CLIENT_ID=your-prod-client-id

# ============================================
# OPENTELEMETRY
# ============================================
# TODO: Update with your production observability endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4317
OTEL_SERVICE_NAME=hasura-ddn-production

# ============================================
# POSTGRESQL CONNECTION POOL
# ============================================
# TODO: Adjust for production workload
POSTGRES_POOL_MAX_CONNECTIONS=100
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_IDLE_TIMEOUT=300

# ============================================
# DOCKER REGISTRY
# ============================================
# TODO: Update with your Docker registry
DOCKER_REGISTRY=docker.io/your-username

# ============================================
# KUBERNETES
# ============================================
K8S_NAMESPACE=hasura-production

# ============================================
# PRODUCTION SETTINGS
# ============================================
ENVIRONMENT=production
LOG_LEVEL=warn

# SECURITY: Disable in production for security
GRAPHQL_INTROSPECTION_ENABLED=false
GRAPHQL_PLAYGROUND_ENABLED=false

# SECURITY: Use specific origins, not "*"
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
