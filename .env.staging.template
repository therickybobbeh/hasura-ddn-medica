# Staging Environment Configuration Template
# Copy this file: cp .env.staging.template .env.staging
# Then update with your actual staging environment values
# DO NOT commit .env.staging with real credentials to Git!

# ============================================
# HASURA DDN
# ============================================
# TODO: Get your Personal Access Token from https://console.hasura.io/settings/tokens
HASURA_DDN_PAT=ddn_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# POSTGRESQL DATABASE
# ============================================
# TODO: Update with your staging database connection string
# Primary database
DATABASE_URL=postgresql://user:password@staging-db.example.com:5432/mydb_staging
CONNECTION_URI=${DATABASE_URL}

# TODO: (Optional) Configure read replicas if available
# Read replicas (optional)
# READ_REPLICA_1_URL=postgresql://user:password@staging-db-replica1.example.com:5432/mydb_staging
# READ_REPLICA_2_URL=postgresql://user:password@staging-db-replica2.example.com:5432/mydb_staging

# ============================================
# OAUTH / OIDC AUTHENTICATION
# ============================================
# TODO: Update with your staging identity provider details
OAUTH_ISSUER_URL=https://staging-auth.example.com
OAUTH_JWKS_URL=https://staging-auth.example.com/.well-known/jwks.json
OAUTH_AUDIENCE=hasura-api-staging
OAUTH_CLIENT_ID=your-staging-client-id

# ============================================
# OPENTELEMETRY
# ============================================
# TODO: Update with your staging observability endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4317
OTEL_SERVICE_NAME=hasura-ddn-staging

# ============================================
# POSTGRESQL CONNECTION POOL
# ============================================
# TODO: Adjust for staging workload (similar to production)
POSTGRES_POOL_MAX_CONNECTIONS=50
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_IDLE_TIMEOUT=180

# ============================================
# DOCKER REGISTRY
# ============================================
# TODO: Update with your Docker registry
DOCKER_REGISTRY=docker.io/your-username

# ============================================
# KUBERNETES
# ============================================
K8S_NAMESPACE=hasura-staging

# ============================================
# STAGING SETTINGS
# ============================================
ENVIRONMENT=staging
LOG_LEVEL=info
GRAPHQL_INTROSPECTION_ENABLED=true
GRAPHQL_PLAYGROUND_ENABLED=true
CORS_ALLOWED_ORIGINS=https://staging.example.com
