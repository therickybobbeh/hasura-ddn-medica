---
# Example: User Model
# This demonstrates a typical user model with authentication fields,
# timestamps, and role-based permissions.
#
# TO CUSTOMIZE FOR YOUR PROJECT:
# 1. Copy this file to subgraphs/database/metadata/
# 2. Update field names to match your database schema
# 3. Adjust permissions for your specific roles
# 4. Add/remove fields as needed

# Object Type Definition
# This defines the structure of the User model and its fields
kind: ObjectType
version: v1
definition:
  name: User
  description: "Application user with authentication and profile information"
  fields:
    # Primary Key
    # UUID is recommended for distributed systems
    - name: id
      type: Uuid!
      description: "Unique identifier for the user"

    # Authentication Fields
    - name: email
      type: String!
      description: "User's email address - must be unique"

    - name: password_hash
      type: String!
      description: "Hashed password - never expose in API"

    # Profile Fields
    - name: first_name
      type: String
      description: "User's first name (optional)"

    - name: last_name
      type: String
      description: "User's last name (optional)"

    - name: display_name
      type: String
      description: "Preferred display name"

    # Role & Status
    - name: role
      type: String!
      description: "User role: 'user', 'admin', 'manager', etc."

    - name: is_active
      type: Boolean!
      description: "Whether the user account is active"

    - name: is_verified
      type: Boolean!
      description: "Whether the user's email is verified"

    # Metadata Fields
    - name: last_login_at
      type: DateTime
      description: "Timestamp of last successful login"

    - name: created_at
      type: DateTime!
      description: "When the user account was created"

    - name: updated_at
      type: DateTime!
      description: "When the user account was last updated"

  # GraphQL Configuration
  graphql:
    typeName: User
    inputTypeName: UserInput

  # Source Mapping
  # Maps this model to the database table
  dataConnectorTypeMapping:
    - dataConnectorName: postgres
      dataConnectorObjectType: users  # Database table name
      fieldMapping:
        id:
          column:
            name: id
        email:
          column:
            name: email
        password_hash:
          column:
            name: password_hash
        first_name:
          column:
            name: first_name
        last_name:
          column:
            name: last_name
        display_name:
          column:
            name: display_name
        role:
          column:
            name: role
        is_active:
          column:
            name: is_active
        is_verified:
          column:
            name: is_verified
        last_login_at:
          column:
            name: last_login_at
        created_at:
          column:
            name: created_at
        updated_at:
          column:
            name: updated_at

---
# Model Permissions
# Defines who can access this model and what they can see/do
kind: ModelPermissions
version: v1
definition:
  modelName: User
  permissions:
    # Admin Role - Full Access
    # Admins can see all users and all fields
    - role: admin
      select:
        filter: null  # null = no filter, can see everything

    # User Role - Restricted Access
    # Users can only see their own record
    - role: user
      select:
        # Row-level security: only return rows where user_id matches session
        filter:
          fieldComparison:
            field: id
            operator: _eq
            value:
              sessionVariable: x-hasura-user-id

        # Field-level security: hide sensitive fields
        # Users can't see other users' password hashes
        allowedFields:
          - id
          - email
          - first_name
          - last_name
          - display_name
          - role
          - is_active
          - is_verified
          - last_login_at
          - created_at
          - updated_at
          # Note: password_hash is NOT in this list

    # Anonymous Role - Very Restricted
    # Unauthenticated users can't query users at all
    # (Commenting this out means anonymous gets no access by default)
    # - role: anonymous
    #   select:
    #     filter:
    #       _exists:
    #         _table:
    #           name: users
    #         _where:
    #           id:
    #             _eq: "00000000-0000-0000-0000-000000000000"  # Always false

---
# SELECT MANY Query Permissions
# Controls the users { ... } query
kind: SelectPermissions
version: v1
definition:
  modelName: User
  permissions:
    # Admins can query all users
    - role: admin
      select:
        filter: null
        allowAggregations: true  # Can use count(), max(), etc.

    # Regular users can only query themselves
    - role: user
      select:
        filter:
          fieldComparison:
            field: id
            operator: _eq
            value:
              sessionVariable: x-hasura-user-id
        allowAggregations: false  # Can't run aggregations

---
# USAGE EXAMPLES
#
# 1. Query your own user info (as 'user' role):
#
#    query {
#      users {
#        id
#        email
#        first_name
#        last_name
#      }
#    }
#
#    Result: Only returns the current user's record
#
# 2. Query all users (as 'admin' role):
#
#    query {
#      users {
#        id
#        email
#        role
#        is_active
#      }
#    }
#
#    Result: Returns all users in the database
#
# 3. Count users (as 'admin' role):
#
#    query {
#      users_aggregate {
#        aggregate {
#          count
#        }
#      }
#    }
#
# 4. Get specific user by ID (as 'admin' role):
#
#    query {
#      users(where: { id: { _eq: "uuid-here" } }) {
#        id
#        email
#      }
#    }
#
# CUSTOMIZATION TIPS:
#
# - Add more roles (manager, moderator, etc.) with custom permissions
# - Add relationships to other models (orders, posts, etc.)
# - Add computed fields (full_name, age_in_days, etc.)
# - Add custom validations in insert/update permissions
# - Use session variables for multi-tenancy (x-hasura-org-id)
