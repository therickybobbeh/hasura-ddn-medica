#   # Session variables returned by webhook
#   allowedSessionVariableNames:
#     - x-hasura-user-id
#     - x-hasura-role
#     - x-hasura-org-id
#
#   allowUnauthenticatedAccess: false

---
# OAuth/OIDC Provider Setup Instructions
#
# The following environment variables need to be configured:
#
# 1. OAUTH_JWKS_URL
#    - The JWKS endpoint URL from your OAuth/OIDC provider
#    - Used to fetch public keys for JWT signature verification
#
# 2. OAUTH_ISSUER_URL
#    - The issuer URL from your OAuth/OIDC provider
#    - Must match the "iss" claim in the JWT token
#
# 3. OAUTH_AUDIENCE
#    - The expected audience for JWT tokens
#    - Must match the "aud" claim in the JWT token
#
# 4. OAUTH_CLIENT_ID (optional, for token exchange)
#    - Your OAuth client ID
#
# Example JWT Token Structure:
# {
#   "iss": "https://auth.example.com",
#   "aud": "https://hasura.example.com",
#   "sub": "user-123",
#   "exp": 1234567890,
#   "iat": 1234567890,
#   "https://hasura.io/jwt/claims": {
#     "x-hasura-user-id": "user-123",
#     "x-hasura-role": "user",
#     "x-hasura-allowed-roles": ["user", "admin"],
#     "x-hasura-default-role": "user",
#     "x-hasura-org-id": "org-456",
#     "x-hasura-email": "user@example.com",
#     "x-hasura-user-name": "John Doe"
#   }
# }
#
# Provider-Specific Setup:
#
# KEYCLOAK:
# ---------
# 1. Create a Realm: "my-realm"
# 2. Create a Client: "hasura-ddn"
#    - Client Protocol: openid-connect
#    - Access Type: confidential
#    - Valid Redirect URIs: https://hasura.example.com/*
# 3. Create Client Scope: "hasura"
#    - Add Protocol Mapper: "hasura-claims"
#      - Mapper Type: User Attribute
#      - Token Claim Name: https://hasura.io/jwt/claims
#      - Claim JSON Type: JSON
# 4. Environment Variables:
#    OAUTH_JWKS_URL=https://keycloak.example.com/realms/my-realm/protocol/openid-connect/certs
#    OAUTH_ISSUER_URL=https://keycloak.example.com/realms/my-realm
#    OAUTH_AUDIENCE=hasura-ddn
#
# AUTH0:
# ------
# 1. Create an Application (Single Page App or Regular Web App)
# 2. Add "https://hasura.io/jwt/claims" namespace in Rules:
#    function (user, context, callback) {
#      const namespace = "https://hasura.io/jwt/claims";
#      context.idToken[namespace] = {
#        'x-hasura-user-id': user.user_id,
#        'x-hasura-role': user.role || 'user',
#        'x-hasura-allowed-roles': user.roles || ['user'],
#        'x-hasura-default-role': 'user'
#      };
#      callback(null, user, context);
#    }
# 3. Environment Variables:
#    OAUTH_JWKS_URL=https://YOUR_DOMAIN.auth0.com/.well-known/jwks.json
#    OAUTH_ISSUER_URL=https://YOUR_DOMAIN.auth0.com/
#    OAUTH_AUDIENCE=YOUR_API_IDENTIFIER
#
# AZURE AD:
# ---------
# 1. Register an App in Azure Portal
# 2. Configure App Roles in manifest
# 3. Add claims mapping policy
# 4. Environment Variables:
#    OAUTH_JWKS_URL=https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys
#    OAUTH_ISSUER_URL=https://login.microsoftonline.com/TENANT_ID/v2.0
#    OAUTH_AUDIENCE=YOUR_CLIENT_ID
#
# OKTA:
# -----
# 1. Create an Application (Web, SPA, or Native)
# 2. Add Custom Claims in Authorization Server
# 3. Environment Variables:
#    OAUTH_JWKS_URL=https://YOUR_DOMAIN.okta.com/oauth2/default/v1/keys
#    OAUTH_ISSUER_URL=https://YOUR_DOMAIN.okta.com/oauth2/default
#    OAUTH_AUDIENCE=api://default
