---
# Authentication Configuration for Hasura DDN
#
# ⚠️  NO AUTHENTICATION BY DEFAULT - FOR TESTING ONLY! ⚠️
# This configuration disables authentication for quick testing and development.
# You MUST enable authentication before deploying to production!
#
# See docs/AUTHENTICATION.md for instructions on enabling OAuth/OIDC authentication.

kind: AuthConfig
version: v2
definition:
  # No authentication mode - allows all requests as admin
  # WARNING: This is insecure! Enable JWT auth for production.
  mode:
    noAuth:
      role: admin
      sessionVariables: {}

---
# To enable authentication, replace the above configuration with one of these options:

# OPTION 1: JWT-based OAuth/OIDC Authentication (Recommended)
# ---------------------------------------------------------------
# kind: AuthConfig
# version: v2
# definition:
#   mode:
#     jwt:
#       audience:
#         valueFromEnv: OAUTH_AUDIENCE
#       issuer:
#         valueFromEnv: OAUTH_ISSUER_URL
#       claims:
#         namespace:
#           claimsFormat: Json
#           location: $.
#         userIdPath: $.sub
#         defaultRolePath: $.role
#         allowedRolesPath: $.roles
#       jwksUri:
#         valueFromEnv: OAUTH_JWKS_URL
#
# Environment variables needed:
# - OAUTH_ISSUER_URL: Your OAuth provider's issuer URL
# - OAUTH_AUDIENCE: Your API audience/identifier
# - OAUTH_JWKS_URL: JWKS endpoint for token verification
#
# Examples:
# - Auth0: OAUTH_ISSUER_URL=https://YOUR_DOMAIN.auth0.com/
# - Keycloak: OAUTH_ISSUER_URL=https://keycloak.example.com/realms/my-realm
# - Azure AD: OAUTH_ISSUER_URL=https://login.microsoftonline.com/TENANT_ID/v2.0

# OPTION 2: Webhook-based Authentication
# ---------------------------------------------------------------
# kind: AuthConfig
# version: v2
# definition:
#   mode:
#     webhook:
#       url:
#         valueFromEnv: AUTH_WEBHOOK_URL
#       method: POST

---
# For detailed authentication setup instructions, see docs/AUTHENTICATION.md
