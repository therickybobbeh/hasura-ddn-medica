---
# Authentication Configuration for Hasura DDN
# OAuth/OIDC Integration with configurable identity provider

kind: AuthConfig
version: v2
definition:
  # Authentication mode: JWT-based OAuth/OIDC
  mode: jwt

  # JWT Configuration
  jwt:
    # JWT token location (from Authorization header)
    tokenLocation:
      type: BearerAuthorization

    # JWT Claims mapping
    claimsConfig:
      namespace:
        # Claims namespace (adjust based on your IdP)
        # Examples:
        # - Keycloak: "https://hasura.io/jwt/claims"
        # - Auth0: "https://hasura.io/jwt/claims"
        # - Azure AD: "https://hasura.io/jwt/claims"
        claimsFormat: Json
        location: "https://hasura.io/jwt/claims"

      # Role claim configuration
      audience:
        - valueFromEnv: OAUTH_AUDIENCE

    # JWKS Configuration for token verification
    jwksConfig:
      # JWKS URI from your OAuth/OIDC provider
      # Examples:
      # - Keycloak: https://keycloak.example.com/realms/my-realm/.well-known/jwks.json
      # - Auth0: https://YOUR_DOMAIN.auth0.com/.well-known/jwks.json
      # - Azure AD: https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys
      # - Okta: https://YOUR_DOMAIN.okta.com/oauth2/default/v1/keys
      jwksUrl:
        valueFromEnv: OAUTH_JWKS_URL

    # Token issuer validation
    issuer:
      valueFromEnv: OAUTH_ISSUER_URL

  # Session variables from JWT claims
  # These variables are available in permission rules
  # Customize based on your JWT claims structure
  allowedSessionVariableNames:
    - x-hasura-user-id
    - x-hasura-role
    - x-hasura-org-id
    - x-hasura-allowed-roles
    - x-hasura-default-role
    - x-hasura-email
    - x-hasura-user-name

  # Unauthenticated access configuration
  # Set allowUnauthenticatedAccess to true if you want to allow
  # public access to certain fields/models
  allowUnauthenticatedAccess: false

  # Unauthorized role configuration
  # Role assigned to unauthenticated requests (if allowed)
  # unauthorizedRole: anonymous

---
# Alternative: Webhook-based Authentication (commented out)
# Uncomment and configure if you prefer webhook authentication over JWT

# kind: AuthConfig
# version: v2
# definition:
#   mode: webhook
