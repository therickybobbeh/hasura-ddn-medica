---
# GraphQL Configuration for Hasura DDN
# Basic configuration for local development and testing

kind: GraphqlConfig
version: v2
definition:
  # GraphQL Query settings
  query:
    # Root operation type name
    rootOperationTypeName: Query

  # GraphQL Mutation settings
  mutation:
    # Root operation type name
    rootOperationTypeName: Mutation

  # Apollo Federation support (disabled by default)
  apolloFederation:
    enableRootFields: false

---
# For production deployments, consider adding:
# - Rate limiting
# - Query depth limits
# - CORS configuration
# - Response headers
#
# See docs/SECURITY.md for production hardening recommendations
