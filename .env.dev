# Development Environment Configuration
# DO NOT commit real credentials to Git!

# ============================================
# HASURA DDN
# ============================================
HASURA_DDN_PAT=ddn_pat_REPLACE_ME

# ============================================
# NEON POSTGRESQL DATABASE
# ============================================
# Primary database
NEON_DATABASE_URL=postgresql://user:password@dev-db.neon.tech:5432/medica_dev

# Read replicas (optional)
NEON_READ_REPLICA_1_URL=postgresql://user:password@dev-db-replica1.neon.tech:5432/medica_dev
NEON_READ_REPLICA_2_URL=postgresql://user:password@dev-db-replica2.neon.tech:5432/medica_dev

# ============================================
# OAUTH / OIDC AUTHENTICATION
# ============================================
OAUTH_ISSUER_URL=https://dev-auth.yourdomain.com
OAUTH_JWKS_URL=https://dev-auth.yourdomain.com/.well-known/jwks.json
OAUTH_AUDIENCE=hasura-api-dev
OAUTH_CLIENT_ID=hasura-dev-client-id

# ============================================
# OPENTELEMETRY
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4317
OTEL_SERVICE_NAME=hasura-ddn-dev

# ============================================
# POSTGRESQL CONNECTION POOL
# ============================================
POSTGRES_POOL_MAX_CONNECTIONS=50
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_IDLE_TIMEOUT=180
POSTGRES_POOL_CONNECTION_LIFETIME=600

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=dev
LOG_LEVEL=debug
