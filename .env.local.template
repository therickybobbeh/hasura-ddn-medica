# Hasura DDN v3 Environment Variables - Local Development Template
#
# GETTING STARTED:
# 1. Copy this file: `cp .env.local.template .env.local`
# 2. Replace all TODO values with your actual configuration
# 3. Never commit .env.local to Git (it contains secrets!)
#
# See QUICKSTART.md for detailed setup instructions
# See globals/README.md for authentication configuration help

# ===========================
# Hasura DDN Configuration
# ===========================

# TODO: Get your Personal Access Token from https://console.hasura.io/settings/tokens
# This is required for DDN CLI commands (ddn supergraph build, etc.)
HASURA_DDN_PAT=ddn_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# Database Configuration
# ===========================

# TODO: Update with your PostgreSQL connection strings
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# Examples:
#   - Local:     postgresql://postgres:password@localhost:5432/mydb
#   - Neon:      postgresql://user:pass@ep-cool-name-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
#   - Supabase:  postgresql://postgres:pass@db.abcdefghijk.supabase.co:5432/postgres
#   - AWS RDS:   postgresql://user:pass@mydb.abcdefghijk.us-east-1.rds.amazonaws.com:5432/mydb
#   - Azure:     postgresql://user@server:pass@server.postgres.database.azure.com:5432/db?sslmode=require

# Database 1 - Primary database
DATABASE_1_URL=postgresql://user:password@localhost:5432/database1

# Database 2 - Secondary database
DATABASE_2_URL=postgresql://user:password@localhost:5432/database2

# Legacy DATABASE_URL for backward compatibility (maps to DATABASE_1_URL)
DATABASE_URL=${DATABASE_1_URL}
CONNECTION_URI=${DATABASE_1_URL}

# TODO: (Optional) Configure read replicas for better read performance
# Uncomment and update if you have read replicas configured
#
# READ_REPLICA_1_URL=postgresql://user:password@replica1-host:5432/database
# READ_REPLICA_2_URL=postgresql://user:password@replica2-host:5432/database

# Connection Pool Settings
# TODO: Adjust based on your database capacity and expected traffic
#
# Recommendations:
#   - Local development:  maxConnections=10,  timeout=10
#   - Production:         maxConnections=50,  timeout=30
#
# See: subgraphs/database/README.md for tuning guide
POSTGRES_POOL_MAX_CONNECTIONS=10
POSTGRES_POOL_TIMEOUT=10
POSTGRES_POOL_IDLE_TIMEOUT=60

# ===========================
# Authentication (OAuth/OIDC)
# ===========================

# TODO: Configure your OAuth/OIDC identity provider
# See globals/README.md for provider-specific setup guides
#
# Supported providers: Keycloak, Auth0, Azure AD, Okta, or any OIDC-compliant provider

# TODO: Issuer URL from your identity provider
# Must match the "iss" claim in JWT tokens
#
# Examples:
#   - Keycloak:  https://keycloak.example.com/realms/my-realm
#   - Auth0:     https://YOUR_DOMAIN.auth0.com/
#   - Azure AD:  https://login.microsoftonline.com/TENANT_ID/v2.0
#   - Okta:      https://YOUR_DOMAIN.okta.com/oauth2/default
OAUTH_ISSUER_URL=https://your-idp.example.com

# TODO: JWKS URL for JWT signature verification
# Must return public keys for validating JWT signatures
#
# Examples:
#   - Keycloak:  https://keycloak.example.com/realms/my-realm/protocol/openid-connect/certs
#   - Auth0:     https://YOUR_DOMAIN.auth0.com/.well-known/jwks.json
#   - Azure AD:  https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys
#   - Okta:      https://YOUR_DOMAIN.okta.com/oauth2/default/v1/keys
OAUTH_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json

# TODO: Expected audience in JWT tokens
# Must match the "aud" claim in JWT tokens
#
# Typically: Your GraphQL API identifier or URL
OAUTH_AUDIENCE=https://hasura.example.com

# TODO: (Optional) OAuth Client ID
# Required if you're implementing token exchange or client credentials flow
OAUTH_CLIENT_ID=your-client-id-here

# ===========================
# Observability (Optional)
# ===========================

# TODO: (Optional) OpenTelemetry Collector Endpoint
# For observability and distributed tracing
# Leave empty to disable OpenTelemetry
#
# Examples:
#   - Local:      http://localhost:4317
#   - Kubernetes: http://otel-collector.monitoring.svc.cluster.local:4317
#   - Dynatrace:  https://your-env.live.dynatrace.com/api/v2/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# TODO: (Optional) Service name for observability
# Used to identify this service in traces and metrics
OTEL_SERVICE_NAME=hasura-ddn-engine

# ===========================
# Docker Registry
# ===========================

# TODO: Update with your Docker registry
# Used by scripts/build-engine.sh and scripts/deploy-metadata.sh
#
# Examples:
#   - Docker Hub:  docker.io/your-username
#   - GHCR:        ghcr.io/your-org
#   - ECR:         123456789012.dkr.ecr.us-east-1.amazonaws.com
#   - ACR:         yourregistry.azurecr.io
#   - GCR:         gcr.io/your-project
DOCKER_REGISTRY=docker.io/your-username

# Docker image name
# TODO: (Optional) Change if you want a different image name
IMAGE_NAME=hasura-ddn-engine

# ===========================
# Kubernetes Configuration
# ===========================

# TODO: Update with your Kubernetes namespace for local/dev environment
# Used by scripts/deploy-metadata.sh
K8S_NAMESPACE=hasura-local

# TODO: (Optional) Ingress hostname for local development
# Used if you have ingress configured
INGRESS_HOSTNAME=hasura.local

# ===========================
# Development Settings
# ===========================

# Environment name
ENVIRONMENT=local

# TODO: Adjust log level as needed
# Options: debug, info, warn, error
# Recommendation: debug for local, info for production
LOG_LEVEL=debug

# Enable GraphQL introspection and playground
# TODO: Set to false in production for security
GRAPHQL_INTROSPECTION_ENABLED=true
GRAPHQL_PLAYGROUND_ENABLED=true

# CORS Configuration
# TODO: Update for production with specific origins
# For local development: * (allow all origins)
# For production: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*

# ===========================
# Optional: Custom Connectors
# ===========================

# TODO: (Optional) Configure if using custom TypeScript connectors
# See examples/typescript-connector/HOW_TO_USE.md
#
# TYPESCRIPT_CONNECTOR_PORT=8080
# OTEL_SERVICE_NAME_TYPESCRIPT_CONNECTOR=typescript-connector

# ===========================
# Optional: Additional Services
# ===========================

# TODO: (Optional) Add environment variables for additional services
# Examples:
#
# # Stripe API
# STRIPE_API_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
#
# # SendGrid
# SENDGRID_API_KEY=SG.xxxxx
#
# # AWS S3
# AWS_ACCESS_KEY_ID=AKIAXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_S3_BUCKET=my-bucket
# AWS_REGION=us-east-1

---
# NEXT STEPS:
#
# 1. Copy this file:
#    $ cp .env.local.template .env.local
#
# 2. Edit .env.local with your actual values
#    $ nano .env.local  # or use your preferred editor
#
# 3. Load environment:
#    $ source .env.local
#    # or:
#    $ export $(cat .env.local | xargs)
#
# 4. Verify configuration:
#    $ echo $DATABASE_URL
#    $ ddn version  # Should work if HASURA_DDN_PAT is set
#
# 5. Test database connection:
#    $ psql "$DATABASE_URL" -c "SELECT 1"
#
# 6. Continue with QUICKSTART.md
#
# SECURITY NOTES:
# - NEVER commit .env.local to Git
# - Add .env.local to .gitignore (already done)
# - Use secrets management in production (Kubernetes Secrets, Vault, etc.)
# - Rotate credentials regularly
# - Use separate credentials per environment
#
# FURTHER READING:
# - Quick Start Guide: QUICKSTART.md
# - Authentication Setup: globals/README.md
# - Database Setup: subgraphs/database/README.md
# - Scripts Usage: scripts/README.md
