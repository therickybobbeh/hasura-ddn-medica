FROM ghcr.io/hasura/ndc-nodejs-lambda:v1.6.0

# Set working directory
WORKDIR /functions

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies
RUN npm install

# Copy function code
COPY functions.ts ./

# Build TypeScript
RUN npm run build

# Expose connector port
ENV HASURA_CONNECTOR_PORT=8080
EXPOSE 8080

# The base image handles starting the connector
CMD ["npm", "start"]
