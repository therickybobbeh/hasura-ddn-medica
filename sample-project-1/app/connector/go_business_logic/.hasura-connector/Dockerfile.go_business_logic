FROM ghcr.io/hasura/ndc-go-lambda:v1.6.0 AS builder

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum* ./

# Download dependencies
RUN go mod download

# Copy source code
COPY functions/ ./functions/

# Build the application
RUN go build -o /connector ./functions/

# Final stage
FROM ghcr.io/hasura/ndc-go-lambda:v1.6.0

WORKDIR /app

# Copy binary from builder
COPY --from=builder /connector /app/connector

# Expose connector port
ENV HASURA_CONNECTOR_PORT=8080
EXPOSE 8080

# Run the connector
CMD ["/app/connector"]
