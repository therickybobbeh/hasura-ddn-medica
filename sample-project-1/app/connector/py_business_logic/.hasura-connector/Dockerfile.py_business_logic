FROM ghcr.io/hasura/ndc-python-lambda:v1.6.0

# Set working directory
WORKDIR /functions

# Copy requirements
COPY requirements.txt ./

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy function code
COPY functions.py ./

# Expose connector port
ENV HASURA_CONNECTOR_PORT=8080
EXPOSE 8080

# The base image handles starting the connector
CMD ["python", "-m", "hasura_ndc"]
