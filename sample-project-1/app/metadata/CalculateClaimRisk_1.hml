---
kind: ObjectType
version: v1
definition:
  name: ClaimData_1
  description: >-
    Insurance Claim Processing Business Logic - TypeScript Implementation


    This connector implements identical business logic to the Go and Python connectors

    for fair performance comparison. All algorithms have O(1) complexity for single

    operations and O(n) for batch operations.
  fields:
    - name: claimAmount
      type: Float!
      description: "Total dollar amount billed for claim. Used in risk scoring, benefit calculations, and outlier detection algorithms."
    - name: claimId
      type: String!
      description: "Unique claim identifier. Primary tracking ID for adjudication workflow, audit trails, and cross-system references."
    - name: claimType
      type: String!
      description: "Category of service (medical, dental, pharmacy, etc). Determines which benefit plan rules and coverage limits apply during adjudication."
    - name: memberId
      type: String!
      description: "Unique member/patient identifier. Links claim to insurance policy for eligibility verification and benefit determination."
    - name: providerId
      type: String
      description: "National Provider Identifier (NPI) of rendering provider. Used for provider network validation, contract pricing, and fraud pattern analysis."
    - name: serviceDate
      type: String!
      description: "Date service was rendered (Date of Service - DOS). Critical for eligibility determination, timely filing limits, and coordination of benefits."
  graphql:
    typeName: ClaimData1
    inputTypeName: ClaimData1Input
  dataConnectorTypeMapping:
    - dataConnectorName: ts_buisness_logic_1
      dataConnectorObjectType: ClaimData

---
kind: TypePermissions
version: v1
definition:
  typeName: ClaimData_1
  permissions:
    - role: admin
      output:
        allowedFields:
          - claimAmount
          - claimId
          - claimType
          - memberId
          - providerId
          - serviceDate

---
kind: ObjectType
version: v1
definition:
  name: RiskScore_1
  fields:
    - name: claimId
      type: String!
      description: "Unique claim identifier this risk score applies to. Links assessment back to original claim for SIU review and audit trails."
    - name: factors
      type: "[String!]!"
      description: "Array of contributing risk factors detected (e.g., 'high_amount', 'unusual_provider', 'duplicate_service'). Provides explainability for fraud investigators."
    - name: riskLevel
      type: String!
      description: "Categorical risk classification (LOW, MEDIUM, HIGH, CRITICAL). Determines routing to automated approval, prepayment review, or SIU investigation."
    - name: riskScore
      type: Float!
      description: "Numeric fraud risk score from 0-100. Calculated from claim amount anomalies, provider patterns, and member utilization history."
    - name: timestamp
      type: String!
      description: "ISO 8601 timestamp when risk assessment was performed. Used for audit compliance and tracking risk score changes over claim lifecycle."
  graphql:
    typeName: RiskScore1
    inputTypeName: RiskScore1Input
  dataConnectorTypeMapping:
    - dataConnectorName: ts_buisness_logic_1
      dataConnectorObjectType: RiskScore

---
kind: TypePermissions
version: v1
definition:
  typeName: RiskScore_1
  permissions:
    - role: admin
      output:
        allowedFields:
          - claimId
          - factors
          - riskLevel
          - riskScore
          - timestamp

---
kind: Command
version: v1
definition:
  name: CalculateClaimRisk_1
  outputType: RiskScore_1!
  arguments:
    - name: claim
      type: ClaimData_1!
  source:
    dataConnectorName: ts_buisness_logic_1
    dataConnectorCommand:
      function: calculateClaimRisk
  graphql:
    rootFieldName: calculateClaimRiskTs
    rootFieldKind: Query
  description: "Calculates fraud risk score for insurance claim using TypeScript implementation. Analyzes claim amount, procedure code patterns, provider history, and member utilization to detect anomalies. Returns risk score (0-100) with contributing factors. Used for Special Investigations Unit (SIU) referrals and prepayment review workflows. Algorithmically equivalent to Go and Python implementations."

---
kind: CommandPermissions
version: v1
definition:
  commandName: CalculateClaimRisk_1
  permissions:
    - role: admin
      allowExecution: true

