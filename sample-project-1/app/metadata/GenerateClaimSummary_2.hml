---
kind: ObjectType
version: v1
definition:
  name: GenerateClaimSummaryClaim
  fields:
    - name: claimAmount
      type: Float!
      description: "Total dollar amount billed for claim. Used in risk scoring, benefit calculations, and outlier detection algorithms."
    - name: claimId
      type: String!
      description: "Unique claim identifier. Primary tracking ID for adjudication workflow, audit trails, and cross-system references."
    - name: claimType
      type: String!
      description: "Category of service (medical, dental, pharmacy, etc). Determines which benefit plan rules and coverage limits apply during adjudication."
    - name: memberId
      type: String!
      description: "Unique member/patient identifier. Links claim to insurance policy for eligibility verification and benefit determination."
    - name: providerId
      type: String
      description: "National Provider Identifier (NPI) of rendering provider. Used for provider network validation, contract pricing, and fraud pattern analysis."
    - name: serviceDate
      type: String!
      description: "Date service was rendered (Date of Service - DOS). Critical for eligibility determination, timely filing limits, and coordination of benefits."
  graphql:
    typeName: GenerateClaimSummaryClaim
    inputTypeName: GenerateClaimSummaryClaimInput
  dataConnectorTypeMapping:
    - dataConnectorName: py_buisness_logic_1
      dataConnectorObjectType: generate_claim_summary_claim
      fieldMapping:
        claimAmount:
          column:
            name: claim_amount
        claimId:
          column:
            name: claim_id
        claimType:
          column:
            name: claim_type
        memberId:
          column:
            name: member_id
        providerId:
          column:
            name: provider_id
        serviceDate:
          column:
            name: service_date

