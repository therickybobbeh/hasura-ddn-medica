        - fieldName: result
          booleanExpressionType: JsonbBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: EligibilityChecksBoolExp

---
kind: AggregateExpression
