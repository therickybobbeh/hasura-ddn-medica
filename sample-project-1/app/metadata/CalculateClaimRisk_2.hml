---
kind: ObjectType
version: v1
definition:
  name: CalculateClaimRisk
  fields:
    - name: claimId
      type: String!
      description: "Unique claim identifier this risk score applies to. Links assessment back to original claim for SIU review and audit trails."
    - name: factors
      type: "[String!]!"
      description: "Array of contributing risk factors detected (e.g., 'high_amount', 'unusual_provider', 'duplicate_service'). Provides explainability for fraud investigators."
    - name: riskLevel
      type: String!
      description: "Categorical risk classification (LOW, MEDIUM, HIGH, CRITICAL). Determines routing to automated approval, prepayment review, or SIU investigation."
    - name: riskScore
      type: Float!
      description: "Numeric fraud risk score from 0-100. Calculated from claim amount anomalies, provider patterns, and member utilization history."
    - name: timestamp
      type: String!
      description: "ISO 8601 timestamp when risk assessment was performed. Used for audit compliance and tracking risk score changes over claim lifecycle."
  graphql:
    typeName: CalculateClaimRisk
    inputTypeName: CalculateClaimRiskInput
  dataConnectorTypeMapping:
    - dataConnectorName: py_buisness_logic_1
      dataConnectorObjectType: calculate_claim_risk
      fieldMapping:
        claimId:
          column:
            name: claim_id
        factors:
          column:
            name: factors
        riskLevel:
          column:
            name: risk_level
        riskScore:
          column:
            name: risk_score
        timestamp:
          column:
            name: timestamp

---
kind: TypePermissions
version: v1
definition:
  typeName: CalculateClaimRisk
  permissions:
    - role: admin
      output:
        allowedFields:
          - claimId
          - factors
          - riskLevel
          - riskScore
          - timestamp

---
kind: Command
version: v1
definition:
  name: CalculateClaimRisk_2
  outputType: CalculateClaimRisk!
  arguments:
    - name: claim
      type: CalculateClaimRiskClaim!
  source:
    dataConnectorName: py_buisness_logic_1
    dataConnectorCommand:
      function: calculate_claim_risk
  graphql:
    rootFieldName: calculateClaimRiskPy
    rootFieldKind: Query
  description: "Calculates fraud risk score for insurance claim using Python implementation. Analyzes claim amount, procedure code patterns, provider history, and member utilization to detect anomalies. Returns risk score (0-100) with contributing factors. Used for Special Investigations Unit (SIU) referrals and prepayment review workflows. Algorithmically equivalent to Go and TypeScript implementations."

