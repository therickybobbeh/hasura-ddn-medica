---
kind: ObjectType
version: v1
definition:
  name: Claims_1
  description: Medical claims submitted by healthcare providers for reimbursement. Represents requests for payment based on services provided, tracked through adjudication from submission to payment or denial.
  fields:
    - name: allowedCents
      type: Int32!
      description: Amount plan allows in cents. Maximum reimbursement based on contracted rates. Difference from chargeCents may be written off (in-network) or balance-billed (out-of-network).
    - name: chargeCents
      type: Int32!
      description: Amount provider billed in cents (e.g., 50000 = $500.00). Provider's standard charge before contractual adjustments.
    - name: cpt
      type: String_1!
      description: Current Procedural Terminology code (5-digit). Standardized medical procedure code (e.g., 99213 for office visit, 70450 for CT scan).
    - name: createdAt
      type: Timestamptz!
      description: Timestamp when claim was submitted to system for processing.
    - name: denialReason
      type: String_1
      description: Explanation for denied claims. Common values - "Not eligible on DOS", "Service not covered", "Duplicate claim", "Coding error". Required when status is DENIED.
    - name: dos
      type: Date!
      description: Date of Service - actual date services were provided. Critical for eligibility verification, timely filing, and benefit period tracking.
    - name: id
      type: Uuid!
      description: Unique claim identifier. Primary key for billing, audit tracking, and claim relationships.
    - name: memberId
      type: Uuid!
      description: Foreign key to member who received services. Links claim to patient record and eligibility.
    - name: providerId
      type: Uuid!
      description: Foreign key to provider who rendered services. Links claim to billing provider and network status.
    - name: status
      type: String_1!
      description: Claim adjudication status. Valid values - PENDING (awaiting review), PAID (approved and paid), DENIED (rejected, see denialReason).
    - name: updatedAt
      type: Timestamptz!
      description: Timestamp of last status change or claim modification.
  graphql:
    typeName: Claims1
    inputTypeName: Claims1Input
  dataConnectorTypeMapping:
    - dataConnectorName: neon_postgres_2
      dataConnectorObjectType: claims
      fieldMapping:
        allowedCents:
          column:
            name: allowed_cents
        chargeCents:
          column:
            name: charge_cents
        cpt:
          column:
            name: cpt
        createdAt:
          column:
            name: created_at
        denialReason:
          column:
            name: denial_reason
        dos:
          column:
            name: dos
        id:
          column:
            name: id
        memberId:
          column:
            name: member_id
        providerId:
          column:
            name: provider_id
        status:
          column:
            name: status
        updatedAt:
          column:
            name: updated_at

