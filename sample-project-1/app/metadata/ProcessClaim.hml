---
kind: Command
version: v1
definition:
  name: ProcessClaim
  outputType: ClaimProcessResult
  arguments:
    - name: claim
      type: ClaimData!
  source:
    dataConnectorName: go_buisness_logic_1
    dataConnectorCommand:
      procedure: processClaim
    argumentMapping:
      claim: claim
  graphql:
    rootFieldName: processClaimGo
    rootFieldKind: Mutation
  description: "Processes and adjudicates insurance claim using Go implementation. Validates eligibility, checks benefit coverage, applies plan rules (copay/coinsurance/deductible), and determines approval status. Returns approved amount, processing time, and rejection reason if denied. Executes real-time claim adjudication workflow. Algorithmically equivalent to TypeScript and Python implementations."

---
kind: CommandPermissions
version: v1
definition:
  commandName: ProcessClaim
  permissions:
    - role: admin
      allowExecution: true

