---
kind: ObjectType
version: v1
definition:
  name: Members
  description: Health plan members (patients/subscribers) enrolled in insurance plans. Stores demographic and enrollment information for individuals covered under HMO, PPO, EPO, or POS plans.
  fields:
    - name: createdAt
      type: Timestamptz!
      description: Timestamp when the member record was created in the system.
    - name: dob
      type: Date!
      description: Date of birth. Used for age calculations, eligibility verification, and benefits determination.
    - name: firstName
      type: String_1!
      description: Member's first name as it appears on insurance card.
    - name: id
      type: Uuid!
      description: Unique identifier for the member. Primary key used for all member relationships (claims, appointments, prescriptions).
    - name: lastName
      type: String_1!
      description: Member's last name as it appears on insurance card.
    - name: plan
      type: String_1!
      description: Insurance plan type. Valid values - HMO (requires PCP, referrals needed), PPO (flexible network, no referrals), EPO (network only), POS (hybrid HMO/PPO).
    - name: updatedAt
      type: Timestamptz!
      description: Timestamp of the last update to this member record.
  graphql:
    typeName: Members
    inputTypeName: MembersInput
  dataConnectorTypeMapping:
    - dataConnectorName: neon_postgres_1
      dataConnectorObjectType: members
      fieldMapping:
        createdAt:
          column:
            name: created_at
        dob:
          column:
            name: dob
        firstName:
          column:
            name: first_name
        id:
          column:
            name: id
        lastName:
          column:
            name: last_name
        plan:
          column:
            name: plan
        updatedAt:
          column:
            name: updated_at

---
kind: TypePermissions
version: v1
definition:
  typeName: Members
  permissions:
    - role: admin
      output:
        allowedFields:
          - createdAt
          - dob
          - firstName
          - id
          - lastName
          - plan
          - updatedAt

---
kind: BooleanExpressionType
version: v1
definition:
  name: MembersBoolExp
  operand:
    object:
      type: Members
      comparableFields:
        - fieldName: createdAt
          booleanExpressionType: TimestamptzBoolExp
        - fieldName: dob
          booleanExpressionType: DateBoolExp
        - fieldName: firstName
          booleanExpressionType: TextBoolExp
        - fieldName: id
          booleanExpressionType: UuidBoolExp
        - fieldName: lastName
          booleanExpressionType: TextBoolExp
        - fieldName: plan
          booleanExpressionType: TextBoolExp
        - fieldName: updatedAt
          booleanExpressionType: TimestamptzBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: MembersBoolExp

---
kind: AggregateExpression
version: v1
definition:
  name: MembersAggExp
  operand:
    object:
      aggregatedType: Members
      aggregatableFields:
        - fieldName: createdAt
          aggregateExpression: TimestamptzAggExp
        - fieldName: dob
          aggregateExpression: DateAggExp
        - fieldName: firstName
          aggregateExpression: TextAggExp
        - fieldName: id
          aggregateExpression: UuidAggExp
        - fieldName: lastName
          aggregateExpression: TextAggExp
        - fieldName: plan
          aggregateExpression: TextAggExp
        - fieldName: updatedAt
          aggregateExpression: TimestamptzAggExp
  count:
    enable: true
    returnType: Int64
  graphql:
    selectTypeName: MembersAggExp

---
kind: OrderByExpression
version: v1
definition:
  name: MembersOrderByExp
  operand:
    object:
      orderedType: Members
      orderableFields:
        - fieldName: createdAt
          orderByExpression: TimestamptzOrderByExp
        - fieldName: dob
          orderByExpression: DateOrderByExp
        - fieldName: firstName
          orderByExpression: String1OrderByExp
        - fieldName: id
          orderByExpression: UuidOrderByExp
        - fieldName: lastName
          orderByExpression: String1OrderByExp
        - fieldName: plan
          orderByExpression: String1OrderByExp
        - fieldName: updatedAt
          orderByExpression: TimestamptzOrderByExp
      orderableRelationships: []
  graphql:
    expressionTypeName: MembersOrderByExp

---
kind: Model
version: v2
definition:
  name: Members
  objectType: Members
  source:
    dataConnectorName: neon_postgres_1
    collection: members
  filterExpressionType: MembersBoolExp
  aggregateExpression: MembersAggExp
  orderByExpression: MembersOrderByExp
  graphql:
    selectMany:
      queryRootField: members
      subscription:
        rootField: members
    selectUniques:
      - queryRootField: membersById
        uniqueIdentifier:
          - id
        subscription:
          rootField: membersById
    filterInputTypeName: MembersFilterInput
    aggregate:
      queryRootField: membersAggregate
      subscription:
        rootField: membersAggregate
  description: Health plan members (patients/subscribers) enrolled in insurance plans. Stores demographic and enrollment information for individuals covered under HMO, PPO, EPO, or POS plans.

---
kind: ModelPermissions
version: v1
definition:
  modelName: Members
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

