kind: DataConnectorLink
version: v1
definition:
  name: ts_buisness_logic_1
  url:
    readWriteUrls:
      read:
        valueFromEnv: APP_TS_BUISNESS_LOGIC_1_READ_URL
      write:
        valueFromEnv: APP_TS_BUISNESS_LOGIC_1_WRITE_URL
  headers:
    Authorization:
      valueFromEnv: APP_TS_BUISNESS_LOGIC_1_AUTHORIZATION_HEADER
  schema:
    version: v0.2
    schema:
      collections: []
      functions:
        - arguments:
            claim:
              description: Claim data to analyze for fraud risk patterns
              type:
                name: ClaimData
                type: named
          description: Analyzes claim for fraud risk using amount patterns, provider history, and member utilization. Returns risk score (0-100) with contributing factors for SIU referrals.
          name: calculateClaimRisk
          result_type:
            name: RiskScore
            type: named
        - arguments:
            claim:
              description: Claim to generate formatted summary for
              type:
                name: ClaimData
                type: named
          description: Generates formatted claim summary with financial breakdown for EOB generation or member portal display. Includes totals, taxes, and human-readable text.
          name: generateClaimSummary
          result_type:
            name: ClaimSummary
            type: named
        - arguments:
            claims:
              description: Array of claims to analyze for fraud risk in batch
              type:
                element_type:
                  name: ClaimData
                  type: named
                type: array
          description: Batch processes multiple claims for fraud risk analysis. Returns array of risk scores with O(n) complexity for nightly detection runs.
          name: batchCalculateRisk
          result_type:
            element_type:
              name: RiskScore
              type: named
            type: array
      object_types:
        ClaimData:
          description: |-
            Insurance Claim Processing Business Logic - TypeScript Implementation

            This connector implements identical business logic to the Go and Python connectors
            for fair performance comparison. All algorithms have O(1) complexity for single
            operations and O(n) for batch operations.
          fields:
            claimAmount:
              description: Total amount claimed in dollars
              type:
                name: Float
                type: named
            claimId:
              description: Unique claim identifier for tracking and processing
              type:
                name: String
                type: named
            claimType:
              description: Type of claim (e.g., 'medical', 'pharmacy', 'dental')
              type:
                name: String
                type: named
            memberId:
              description: Member ID who received services
              type:
                name: String
                type: named
            providerId:
              description: Provider ID who rendered services (optional for some claim types)
              type:
                type: nullable
                underlying_type:
                  name: String
                  type: named
            serviceDate:
              description: Date services were provided (ISO 8601 format)
              type:
                name: String
                type: named
          foreign_keys: {}
        ClaimProcessResult:
          description: represents the result of processing a claim
          fields:
            approved:
              description: Whether the claim was approved for payment
              type:
                name: Boolean
                type: named
            approvedAmount:
              description: Amount approved for payment in dollars (null if denied)
              type:
                type: nullable
                underlying_type:
                  name: Float
                  type: named
            claimId:
              description: Claim identifier that was processed
              type:
                name: String
                type: named
            processingTime:
              description: Time taken to process in seconds
              type:
                name: Float
                type: named
            rejectionReason:
              description: Reason for denial (null if approved)
              type:
                type: nullable
                underlying_type:
                  name: String
                  type: named
            status:
              description: Processing status ('APPROVED', 'DENIED', 'PENDING_REVIEW')
              type:
                name: String
                type: named
          foreign_keys: {}
        ClaimSummary:
          description: represents a formatted summary of a claim
          fields:
            claimId:
              description: Claim identifier for this summary
              type:
                name: String
                type: named
            memberId:
              description: Member ID associated with this claim
              type:
                name: String
                type: named
            netAmount:
              description: Net amount after all adjustments
              type:
                name: Float
                type: named
            status:
              description: Current claim status
              type:
                name: String
                type: named
            summary:
              description: Human-readable summary text for EOB or member portal
              type:
                name: String
                type: named
            taxAmount:
              description: Calculated tax amount
              type:
                name: Float
                type: named
            totalAmount:
              description: Total claim amount before adjustments
              type:
                name: Float
                type: named
          foreign_keys: {}
        RiskScore:
          description: represents risk assessment result for a claim
          fields:
            claimId:
              description: Claim identifier this risk score applies to
              type:
                name: String
                type: named
            factors:
              description: Array of risk factors that contributed to the score (e.g., 'high_amount', 'unusual_provider', 'duplicate_service')
              type:
                element_type:
                  name: String
                  type: named
                type: array
            riskLevel:
              description: Categorical risk level ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')
              type:
                name: String
                type: named
            riskScore:
              description: Numerical risk score from 0-100, where higher values indicate greater fraud risk
              type:
                name: Float
                type: named
            timestamp:
              description: When this risk assessment was performed (ISO 8601 format)
              type:
                name: String
                type: named
          foreign_keys: {}
      procedures:
        - arguments:
            claim:
              description: Claim to adjudicate through validation and approval workflow
              type:
                name: ClaimData
                type: named
          description: Adjudicates claim through validation, eligibility check, benefit verification, and approval workflow. Returns approval status with amount or rejection reason.
          name: processClaim
          result_type:
            name: ClaimProcessResult
            type: named
        - arguments:
            claims:
              description: Array of claims to process through adjudication workflow
              type:
                element_type:
                  name: ClaimData
                  type: named
                type: array
          description: Batch adjudicates multiple claims through full processing workflow. Returns array of processing results with O(n) complexity for automated claim processing.
          name: batchProcessClaims
          result_type:
            element_type:
              name: ClaimProcessResult
              type: named
            type: array
      scalar_types:
        Boolean:
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
          representation:
            type: boolean
        Float:
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
          representation:
            type: float64
        String:
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
          representation:
            type: string
    capabilities:
      capabilities:
        mutation: {}
        query:
          nested_fields: {}
          variables: {}
      version: 0.2.0
